datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  NGO_STAFF
  VOLUNTEER
  DONOR
  BENEFICIARY
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  volunteerProfile   VolunteerProfile?
  beneficiaryProfile BeneficiaryProfile?
  donorProfile       DonorProfile?
  notifications      Notification[]
}

enum VolunteerStatus {
  ACTIVE
  INACTIVE
}

model VolunteerProfile {
  id                 String          @id @default(uuid())
  userId             String          @unique
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  phone              String?
  skills             String[]
  availability       String?
  location           String?
  joinedDate         DateTime        @default(now())
  totalHours         Int             @default(0)
  eventsParticipated Int             @default(0)
  status             VolunteerStatus @default(ACTIVE)

  registrations      EventRegistration[]
  projectAssignments ProjectVolunteer[]
}

enum BeneficiaryStatus {
  ACTIVE
  INACTIVE
}

model BeneficiaryProfile {
  id               String            @id @default(uuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  age              Int
  gender           String
  location         String
  contact          String?
  familySize       Int
  program          String
  registrationDate DateTime          @default(now())
  status           BeneficiaryStatus @default(ACTIVE)

  projectAssignments ProjectBeneficiary[]
}

model DonorProfile {
  id           String @id @default(uuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  totalDonated Float  @default(0.0)

  donations Donation[]
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

model Project {
  id                   String        @id @default(uuid())
  name                 String
  description          String
  goal                 Float?
  startDate            DateTime
  endDate              DateTime?
  targetBeneficiaries  Int
  currentBeneficiaries Int           @default(0)
  totalDonations       Float         @default(0.0)
  status               ProjectStatus @default(ACTIVE)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  events        Event[]
  donations     Donation[]
  volunteers    ProjectVolunteer[]
  beneficiaries ProjectBeneficiary[]
}

model ProjectVolunteer {
  projectId   String
  volunteerId String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  volunteer   VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  assignedAt  DateTime         @default(now())

  @@id([projectId, volunteerId])
}

model ProjectBeneficiary {
  projectId     String
  beneficiaryId String
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  beneficiary   BeneficiaryProfile @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  assignedAt    DateTime           @default(now())

  @@id([projectId, beneficiaryId])
}

enum EventStatus {
  UPCOMING
  OPEN_FOR_REGISTRATION
  FULL
  COMPLETED
  CANCELLED
}

model Event {
  id          String      @id @default(uuid())
  name        String
  date        DateTime
  location    String
  capacity    Int
  description String
  duration    Int // Duration in hours to award to volunteers
  projectId   String?
  project     Project?    @relation(fields: [projectId], references: [id])
  status      EventStatus @default(UPCOMING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  registrations EventRegistration[]
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model EventRegistration {
  id           String           @id @default(uuid())
  eventId      String
  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  volunteerId  String
  volunteer    VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  registeredAt DateTime         @default(now())

  attendanceStatus AttendanceStatus?
  hoursLogged      Int               @default(0)

  @@unique([eventId, volunteerId])
}

enum DonationStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

model Donation {
  id            String         @id @default(uuid())
  donorId       String
  donor         DonorProfile   @relation(fields: [donorId], references: [id], onDelete: Restrict)
  projectId     String?
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  amount        Float
  paymentMethod String
  status        DonationStatus @default(PENDING)
  receiptUrl    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
